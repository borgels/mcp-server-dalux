# Key of the Dalux API identity (company settings -> API identities).
DALUX_API_KEY=
# Customer-specific API base URL, copied from the same page in Dalux.
# Must be https on a *.dalux.com host unless DALUX_ALLOW_CUSTOM_BASE_URL=true.
# DALUX_BASE_URL=https://<node>.field.dalux.com/service/api
# DALUX_ALLOW_CUSTOM_BASE_URL=false
DALUX_TIMEOUT_MS=30000
DALUX_MAX_CONCURRENCY=4
# Upper bound for dalux_download_file (bytes, max 104857600). Per-call default is 10 MB.
DALUX_MAX_DOWNLOAD_BYTES=26214400
# Fail fast on Box tools when the project modules show no Box Pro ("false" disables).
# DALUX_LICENSE_PRECHECK=true

# Write tools (upload_file, change_company, change_project) are disabled
# unless this is exactly "true" (same for the other DALUX_* switches).
DALUX_ENABLE_WRITES=false
# Optional narrowing (comma-separated):
DALUX_DISABLED_TOOLS=
DALUX_ALLOWED_PROJECT_IDS=
DALUX_ALLOW_PROJECT_CREATE=false
DALUX_ALLOWED_ADMIN_EMAIL_DOMAINS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
DALUX_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
