DALUX_API_KEY=
# Base URL for the Dalux Build API. Dalux says the URL is confirmed when API
# access is activated — override here if yours differs.
DALUX_BASE_URL=https://field.dalux.com/service/api
DALUX_TIMEOUT_MS=30000
# Write tools (upload_file, change_company, change_project) are disabled
# unless this is exactly "true". Field data (tasks/forms/plans) is read-only
# in the Dalux API regardless.
DALUX_ENABLE_WRITES=false
DALUX_AUDIT_LOG=
